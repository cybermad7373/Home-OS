# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
/supabase/.branches
/supabase/.temp
/supabase/.env

# test artefacts
/test-results
/playwright-report
/blob-report
!.env.example

# Playwright MCP scratch output
.playwright-mcp/
ks-*.png

# The screenshot set from `npm run shoot:ui`. Evidence a person reads, not
# something the repository carries: 38 full-page PNGs per width per theme.
/screenshots

# Scratch drivers used while auditing the running app.
.tmp-*.mjs

# Database dumps. Every household's records in one file; never committed.
backups/

# Operator scratch with live secrets (service-role key, etc.). Never committed
# on any branch — values live in the password manager / host env only.
docs/deploy.txt
**/deploy.txt
