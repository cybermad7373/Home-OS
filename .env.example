# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server and edge functions only, never in a client bundle

# Web Push  (phase 7)
# Generate a pair with `npm run gen:vapid`. The public half goes in the bundle
# by design — it is what the push service checks our signature against. The
# private half belongs to the Edge Functions only:
#   npx supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# LLM  (phase 9 — all optional, absence disables AI features cleanly)
#
# The ordinary path is not this file: a house admin picks a provider and pastes
# their own key while creating the house, and it is stored encrypted against
# that house. This master key is what seals it, and it belongs in the server
# environment and in the Edge Function secrets, identical in both:
#   npm run gen:llmkey
#   npx supabase secrets set LLM_KEY_ENCRYPTION_KEY=...
LLM_KEY_ENCRYPTION_KEY=

# Rotation. New writes seal with this version; rows sealed under an older
# version stay readable, so a rotation is a bump here plus the previous key kept
# available, never a re-encrypt of the table. Leave at 1 until you rotate.
LLM_KEY_ENCRYPTION_KEY_VERSION=1

# Fallback for a deployment that serves exactly one house, and for development.
# A house with its own key never reads these. LLM_PROVIDER accepts any id in
# lib/infra/llm/providers.ts — gemini, groq, openrouter, huggingface, cerebras,
# mistral, openai, anthropic, custom.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Only for provider id `custom`: the OpenAI-compatible base URL.
LLM_BASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The same value, as an Edge Function secret: a job has no request to infer an
# origin from, and the deep links it sends have to be absolute.
#   npx supabase secrets set APP_URL=https://...

# Dev-only quick sign-in (leave empty; never set in production)
NEXT_PUBLIC_DEV_LOGIN_IDENTIFIER=
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# Launch gate — the public surface
#
# Who operates this deployment. Printed on the terms, privacy and support
# pages; until the first two are set, each of those pages shows a marked
# placeholder instead, because a legal page carrying an invented company name
# is a fabricated record.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Analytics. Optional, off unless set, and mounted on the four public pages
# only — sign in, sign up and the three documents. Never behind the login: a
# page view from /more/approvals/<id> hands a third party the shape of a
# household's private argument.
#
# Expected to be a cookieless, script-only counter (Plausible, Umami, Fathom or
# a self-hosted equivalent). A tag that sets cookies makes the cookie notice's
# "two cookies, both necessary" untrue; use a real consent gate instead.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# The Content-Security-Policy is built per request in lib/infra/http/csp.ts and
# is enforced by default. Set this to 1 for a shakedown period on a new deploy
# and the browser reports violations to its console instead of refusing them.
# Leave it unset in production: a policy nobody switched on is not a policy.
CSP_REPORT_ONLY=

# The write limiter (migration 090). A signed-in member may make this many
# writes — POST, PATCH, PUT, DELETE under /api/ — per window. Reads are never
# counted. The counter is a row in Postgres so that two instances of this
# server share one; both values are optional and default to 120 per 60s.
RATE_LIMIT_WRITES=
RATE_LIMIT_WINDOW_SECONDS=

# The revision this deploy was built from — a git sha. Reported by /api/health
# so that "is the running app the one I pushed" has an answer that does not
# involve guessing. Optional; the endpoint reports null when it is unset.
APP_REVISION=
