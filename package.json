{
  "name": "houseos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:functions": "npx deno test --allow-env supabase/functions/_shared",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "gen:types": "supabase gen types typescript --local > lib/types/supabase.ts",
    "gen:types:hosted": "supabase gen types typescript --linked > lib/types/supabase.hosted.ts",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:vapid": "node scripts/generate-vapid.mjs",
    "gen:llmkey": "node scripts/generate-llmkey.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "seed:reset": "node scripts/seed-demo.mjs --reset",
    "seed:verify": "node scripts/seed-demo.mjs --verify",
    "seed:ai": "node scripts/seed-ai.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "fast-check": "^4.9.0",
    "pg": "^8.23.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
